  "suite_schema": "CS-0@3.0.1",
  "summary": "Patch successor to CS-0 v3.0.0. It defines the approved semantics of requires, governance_floor, and foundation_floor, and excludes the overloaded legacy foundation edge from the current dependency schema.",
  "title": "Contract Suite Schema Standard",
  "updated_at": "2026-10-09T00:00:00Z",
  "version": "3.0.1",
  "dependency_edge_type_semantics": [
    {
      "edge_type": "requires",
      "meaning": "A direct dependency required for the consuming contract's own structural, semantic, schema, or executable validity. Use this when the consumer cannot correctly satisfy its own contract without the target dependency. This does not merely establish a platform-wide minimum version.",
      "does_not_imply": []
    },
    {
      "edge_type": "governance_floor",
      "meaning": "A minimum version of a governance, test, lint, change-control, or compliance contract that governs how the consuming contract or suite is validated and controlled. The target establishes governance constraints rather than domain/runtime functionality.",
      "does_not_imply": []
    },
    {
      "edge_type": "foundation_floor",
      "meaning": "A minimum version of a governed platform/domain subsystem required by the constitutional/platform baseline. This establishes the minimum acceptable subsystem contract for suite/V42 compliance.",
      "does_not_imply": [
        "direct runtime invocation",
        "implementation ownership",
        "a direct code dependency",
        "that the consuming contract implements the target subsystem"
      ]
    }
  ]
