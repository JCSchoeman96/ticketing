  "change_log": [
    {
      "id": "CS0-300",
      "summary": "Major write-model hardening: dependency edge_type required, lineage structure introduced, gate schema expanded for title/failure_message and runtime assertion declarations, and manifest path/doc_id constraints tightened."
    },
    {
      "id": "CS0-301",
      "summary": "Defines the ratified dependency edge semantics and excludes the overloaded legacy foundation edge from the current schema."
    },
    {
      "id": "CS0-301-CANDIDATE-STATUS",
      "summary": "Retains canonical=false on the candidate artifact so owner semantic approval does not declare the release canonical."
    }
  ],
  "changelog": [
    {
      "changes": [
        "BREAKING: dependency items now require edge_type in addition to doc_id and min_version.",
        "BREAKING: contract and test-gates doc_id fields now use hardened patterns.",
        "Introduced optional lineage object for canonical supersession and foundation reference metadata.",
        "Expanded test-gate schema to allow gate-level title and failure_message fields.",
        "Expanded assertion type enum to include runtime-harness declarations for dynamic checks.",
        "Hardened bundle.manifest.json file path entries to JSON artifacts only."
      ],
      "date_utc": "2026-04-04T07:45:00Z",
      "type": "major",
      "version": "3.0.0"
    },
    {
      "changes": [
        "Defined the distinct normative meanings of requires, governance_floor, and foundation_floor.",
        "Clarified that foundation_floor does not imply runtime invocation, implementation ownership, a direct code dependency, or implementation of the target subsystem.",
        "The current dependency schema does not accept the overloaded legacy foundation edge; historical schema compatibility is evaluated under the referenced historical schema version.",
        "Keep this successor source at canonical=false until a separate current-suite pinset selects a validated release."
      ],
      "date_utc": "2026-10-09T00:00:00Z",
      "type": "patch",
      "version": "3.0.1"
    }
  ],
