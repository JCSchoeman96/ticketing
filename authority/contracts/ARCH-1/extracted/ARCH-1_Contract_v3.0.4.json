  "retention": {
    "defaults": {
      "derived_exports": {
        "default_days": 30,
        "notes": "Derived export artifacts (CSV, JSON exports) can be tombstoned or hard-deleted after expiry.",
        "purge_action": "tombstone_or_hard_delete",
        "unit": "days"
      },
      "financial_ledger": {
        "min_years": 7,
        "notes": "Ledger records MUST NOT be hard-deleted before 7-year minimum; use cold storage archive.",
        "purge_action": "archive_only",
        "unit": "years"
      },
      "identity_pii": {
        "max_years": 2,
        "notes": "PII may be redacted/pseudonymized while preserving referential integrity for audits.",
        "purge_action": "redact_or_pseudonymize",
        "unit": "years"
      },
      "telemetry_hot": {
        "notes": "Hot telemetry (logs, traces) can be hard-deleted after retention window.",
        "purge_action": "hard_delete",
        "retention_days": 90,
        "unit": "days"
      }
    },
    "legal_hold": {
      "override": "Legal hold takes precedence over retention policies.",
      "rule": "If legal hold is active for org_id or artifact_id, purge MUST be skipped and audited.",
      "supported": true
    },
