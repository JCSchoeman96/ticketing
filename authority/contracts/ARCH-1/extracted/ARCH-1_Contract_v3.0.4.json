        "retryable": false,
        "subcode": "ARCH_HARD_DELETE_LEDGER"
      }
    ],
    "notes": "All ARCH_* subcodes MUST be registered in ERR-1 v1.4.7+ for lock eligibility.",
    "registry": "ERR-1"
  },
