  "doc_id": "ARCH-1",
  "domain_actions": [
    {
      "action": "request_export",
      "authorization": {
        "policy": "Ash.Policy.Authorizer",
        "rules": [
          "actor_id MUST belong to org_id",
          "raw_pii redaction requires IAM-1 step-up auth"
        ]
      },
      "inputs_required": [
        "org_id",
        "actor_id",
        "actor_type",
        "request_id",
        "trace_id",
        "export_type",
        "redaction_profile"
      ],
      "output_minimum": [
        "export_id",
        "state",
        "request_id"
      ],
      "purpose": "Initiate a tenant-scoped data export with specified redaction profile.",
      "resource": "ExportJob"
    },
    {
      "action": "finalize_export",
      "immutability": "After finalization, no mutations allowed; content_hash_sha256 locks artifact.",
      "inputs_required": [
        "org_id",
        "export_id",
        "content_hash_sha256",
        "request_id",
        "trace_id"
      ],
      "output_minimum": [
        "export_id",
        "state",
        "finalized_at"
      ],
      "purpose": "Mark export as immutable and emit finalized event to EVT-1 outbox.",
      "resource": "ExportJob"
    },
    {
      "action": "apply_legal_hold",
      "inputs_required": [
        "org_id",
        "scope",
        "reason",
        "actor_id",
        "request_id",
        "trace_id"
      ],
      "output_minimum": [
        "legal_hold_id",
        "active"
      ],
      "purpose": "Apply legal hold to org or specific artifacts; blocks retention purges.",
      "resource": "LegalHold"
    },
    {
      "action": "release_legal_hold",
      "inputs_required": [
        "org_id",
        "legal_hold_id",
        "actor_id",
        "request_id",
        "trace_id"
      ],
      "output_minimum": [
        "legal_hold_id",
        "active",
        "released_at"
      ],
      "purpose": "Release legal hold; allows retention cycle to resume.",
      "resource": "LegalHold"
    },
    {
      "action": "run_retention_cycle",
      "inputs_required": [
        "org_id",
        "retention_policy_id",
        "run_date",
        "request_id",
        "trace_id"
      ],
      "output_minimum": [
        "purged_count",
        "skipped_legal_hold_count"
      ],
      "purpose": "Execute scheduled retention purge per data class rules; respects legal holds.",
      "resource": "RetentionPolicy",
      "scheduler": {
        "frequency": "daily",
        "idempotency_key": "org_id:retention_policy_id:yyyymmdd",
        "job_system": "AshOban",
        "queue": "ops"
      }
    },
    {
      "action": "redact_pii",
      "inputs_required": [
        "org_id",
        "target_type",
        "target_id",
        "reason",
        "actor_id",
        "request_id",
        "trace_id"
      ],
      "output_minimum": [
        "erasure_id",
        "state"
      ],
      "purpose": "Redact or pseudonymize PII while preserving referential integrity; audit trail required.",
      "resource": "ErasureRequest"
    }
  ],
  "domain_invariants": [
    {
      "category": "topology",
      "id": "ARCH-1-P0-001",
      "rationale": "Prevents ledger corruption by enforcing event-only boundary into Vault zone.",
      "severity": "P0",
      "text": "Cross-zone mutations from Blue to Red MUST be asynchronous via EVT-1 signals; synchronous RPC is forbidden."
    },
    {
      "category": "access_control",
      "id": "ARCH-1-P0-002",
      "rationale": "Prevents cross-tenant data access and unauthorized PII export.",
      "severity": "P0",
      "text": "All export, download, retention purge, and legal-hold actions MUST be authorized via Ash.Policy.Authorizer and tenant-scoped by org_id."
    },
    {
      "category": "immutability",
      "id": "ARCH-1-P0-003",
      "rationale": "Ensures non-repudiation and auditability.",
      "severity": "P0",
      "text": "Finalized export artifacts MUST be immutable; mutations require new export_id and content_hash_sha256."
    },
    {
      "category": "retention",
      "id": "ARCH-1-P0-004",
      "rationale": "Defines enforceable retention targets and legal-hold override semantics.",
      "severity": "P0",
      "text": "Retention MUST enforce financial_ledger.min_years=7, identity_pii.max_years=2, telemetry_hot.retention_days=90 and MUST respect legal holds."
    },
    {
      "category": "retention_data_class",
      "id": "ARCH-1-P0-005",
      "rationale": "Prevents immutability violations on ledger-grade records while allowing compliant PII redaction.",
      "severity": "P0",
      "text": "Purge actions MUST be constrained per data class: financial_ledger\u2192archive_only (no destructive delete before 7yr minimum), identity_pii\u2192redact/pseudonymize, derived_exports\u2192tombstone or hard_delete allowed."
    },
    "If RetentionPolicy.retention_profile == p4_finance_records, purge_action MUST NOT be hard_delete or tombstone_or_hard_delete; archive_only is required."
  ],
  "emits_events": true,
