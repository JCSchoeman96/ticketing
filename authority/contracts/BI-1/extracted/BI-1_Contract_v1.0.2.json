{
  "access_control": {
    "capabilities": {
      "bi.dashboard.view": {
        "description": "View aggregated dashboards.",
        "scope": [
          "org",
          "platform"
        ]
      },
      "bi.metric.drilldown": {
        "description": "Request drilldown into allowed dimensions (subject to privacy_class).",
        "scope": [
          "org",
          "platform"
        ]
      },
      "data.export": {
        "description": "Request exports of C0-C2 aggregate data (non-sensitive).",
        "scope": [
          "org",
          "platform"
        ]
      },
      "data.export.c3": {
        "description": "Request exports of C3 pseudonymous/sensitive data (requires AAL2).",
        "scope": [
          "org",
          "platform"
        ]
      },
      "data.export.c4": {
        "description": "Request exports of C4 PII/restricted data (requires AAL2 + audit + DSAR tagging).",
        "scope": [
          "org",
          "platform"
        ]
      }
    },
    "recommended_role_grants": [
      {
        "actor_kind": "org_owner",
        "grant": [
          "bi.dashboard.view",
          "data.export"
        ]
      },
      {
        "actor_kind": "org_finance_manager",
        "grant": [
          "bi.dashboard.view",
          "data.export",
          "data.export.c3"
        ]
      },
      {
        "actor_kind": "platform_finance_admin",
        "grant": [
          "bi.dashboard.view",
          "bi.metric.drilldown",
          "data.export",
          "data.export.c3",
          "data.export.c4"
        ]
      },
      {
        "actor_kind": "super_admin",
        "grant": [
          "bi.dashboard.view",
          "bi.metric.drilldown",
          "data.export",
          "data.export.c3",
          "data.export.c4"
        ]
      }
    ],
    "resource_kinds": [
      "bi_dashboard",
      "bi_metric",
      "export_job",
      "export_artifact"
    ]
  },
  "anti_patterns": [
    {
      "id": "BI-1-ANTI-TRK-REVENUE",
      "severity": "P0",
      "text": "Do not compute or display 'revenue' from TRK-1 events or client-side payments. This creates phantom revenue."
    },
    {
      "id": "BI-1-ANTI-OLTP-SCAN",
      "severity": "P0",
      "text": "Do not run SUM/COUNT queries over ORD-1/LED-1 OLTP tables in the hot path or per page load."
    },
    {
      "id": "BI-1-ANTI-UNLABELED-APPROX",
      "severity": "P1",
      "text": "Do not hide exactness. If a metric is approximate, it must say so."
    }
  ],
  "artifact_kind": "contract",
  "change_log": [
    {
      "date_utc": "2026-02-02",
      "summary": "Initial BI contract: metric registry, dashboards, rollup read-models, exports, and reconciliation rules.",
      "type": "create",
      "version": "1.0.0"
    }
  ],
  "changelog": [
    {
      "changes": [
        "P1: Declared explicit non-producer surface (emits_events=false, outbox_events=[]).",
        "P1: Added registry floor parity dependency pin on EVT-1@2.16.4.",
        "P1: Added ASSERT-NON-PRODUCER gate to prevent CI theatre."
      ],
      "date_utc": "2026-02-07T00:00:00.000000Z",
      "type": "patch",
      "version": "1.0.1"
    }
  ],
  "dashboards": {
    "dashboard_id_rules": [
      "Lowercase, dot-separated: dash.<scope>.<name>"
    ],
    "dashboards": [
      {
        "dashboard_id": "dash.org.live_sales_overview",
        "default_refresh_sec": 60,
        "notes": [
          "All tiles are indicators during live sales, not settlement truth.",
          "Breakdowns by ticket_type are daily (per PII-1 minimum_time_bucket_for_breakdowns)."
        ],
        "scope": "org",
        "tiles": [
          {
            "label": "Last hour (committed)",
            "metric_id": "ops.gross_revenue_committed.hour_total",
            "show_truth_badge": true
          },
          {
            "label": "Orders last hour",
            "metric_id": "ops.orders_committed.hour_total",
            "show_truth_badge": true
          },
          {
            "label": "Tickets last hour",
            "metric_id": "ops.tickets_sold_committed.hour_total",
            "show_truth_badge": true
          },
          {
            "label": "Today (committed)",
            "metric_id": "finance.gross_revenue_committed.day",
            "show_truth_badge": true
          }
        ],
        "title": "Live Sales Overview"
      },
      {
        "dashboard_id": "dash.org.settled_finance",
        "default_refresh_sec": 900,
        "scope": "org",
        "tiles": [
          {
            "label": "Gross settled",
            "metric_id": "finance.gross_revenue_settled.day",
            "show_truth_badge": true
          },
          {
            "label": "Refunds settled",
            "metric_id": "finance.refunds_settled.day",
            "show_truth_badge": true
          },
          {
            "label": "Net settled",
            "metric_id": "finance.net_revenue_settled.day",
            "show_truth_badge": true
          }
        ],
        "title": "Settled Finance"
      },
      {
        "dashboard_id": "dash.platform.reconciliation_overview",
        "default_refresh_sec": 900,
        "required_actor_kinds": [
          "platform_finance_admin",
          "super_admin"
        ],
        "scope": "platform",
        "tiles": [
          {
            "label": "Committed (today)",
            "metric_id": "finance.gross_revenue_committed.day",
            "show_truth_badge": true
          },
          {
            "label": "Settled (today)",
            "metric_id": "finance.gross_revenue_settled.day",
            "show_truth_badge": true
          }
        ],
        "title": "Reconciliation Overview"
      }
    ]
  },
  "definitions": {
    "terms": [
      {
        "definition": "The authoritative data plane for a metric: ledger-settled, order-committed, or tracking-derived. This is a governance label with enforcement requirements.",
        "term": "truth_source"
      },
      {
        "definition": "Exact or bounded-exact computations that derive finance panels from LED-1 postings and ORD-1 committed states.",
        "term": "reconciliation_lane"
      },
      {
        "definition": "Fast panels optimized for operator situational awareness during sales; may use ORD-1 committed snapshots, but must never be presented as 'settled'.",
        "term": "live_lane"
      },
      {
        "definition": "A period close that freezes finance aggregates for that period; any correction becomes a new revision with explicit variance accounting.",
        "term": "close_and_lock"
      },
      {
        "definition": "C0..C4 sensitivity tier aligned to PII-1.",
        "term": "privacy_class"
      }
    ]
  },
