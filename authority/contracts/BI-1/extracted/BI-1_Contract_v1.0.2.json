      },
      {
        "channel": "obs",
        "event_name": "bi.export_artifact_created",
        "min_fields": [
          "org_id",
          "actor_id",
          "export_job_id",
          "dataset_id",
          "privacy_class",
          "assurance_level",
          "artifact_expires_at_utc"
        ],
        "purpose": "Audit and telemetry for export artifact creation and delivery."
      }
    ],
    "ordering": [
      "bi.query_executed precedes any bi.export_artifact_created emitted for the same request_id",
      "bi.export_artifact_created MUST be emitted after export_artifact persistence succeeds"
    ]
  },
