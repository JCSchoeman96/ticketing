      "succeeded",
      "failed",
      "revoked"
    ],
    "formats": [
      "csv",
      "parquet",
      "jsonl"
    ]
  },
  "invariants": [
    {
      "assertion": "Revenue and fee dashboards MUST derive from LED-1 (settled) and/or ORD-1 (committed). TRK-1 MUST NOT be used as the truth_source for finance metrics.",
      "domain": "finance",
      "enforcement": "schema + gates",
      "id": "BI-1-REV-TRUTH-LED-ORD",
      "level": "P0"
    },
    {
      "assertion": "Any live_lane metric MUST display its truth_source and exactness class (e.g., committed/approximate) on every dashboard tile and export header.",
      "domain": "ux",
      "enforcement": "api + ui contract",
      "id": "BI-1-LIVE-LANE-LABELS",
      "level": "P0"
    },
    {
      "assertion": "BI queries MUST NOT run against OLTP write models. All BI reads MUST come from BI read_models or a read replica dedicated to analytics.",
      "domain": "performance",
      "enforcement": "db role + code review",
      "id": "BI-1-OLTP-ISOLATION",
      "level": "P0"
    },
    {
      "assertion": "Time buckets smaller than 'day' are allowed ONLY for org-owned totals with no dimensions (dimensions_allowed must be empty) and privacy_class must be C0..C2.",
      "domain": "privacy",
      "enforcement": "schema + gates",
      "id": "BI-1-HOURLY-TOTALS-NO-DIMS",
      "level": "P0"
    },
    {
      "assertion": "Any drilldown or export that includes C3 or C4 data MUST require IAM-1 assurance_level >= aal2 and MUST produce an immutable audit record.",
      "domain": "security",
      "enforcement": "auth middleware + audit",
      "id": "BI-1-PII-DRILLDOWN-STEPUP",
      "level": "P0"
    },
    {
      "assertion": "When a period is closed, finance aggregates for that period MUST become immutable. Corrections MUST be recorded as variances (never silent overwrite).",
      "domain": "finance",
      "enforcement": "db constraints + ledger variance",
      "id": "BI-1-CLOSE-AND-LOCK",
      "level": "P0"
    },
    {
      "assertion": "All export_job and export_artifact records are append-only and must be retained per DATA-1 retention tiers; artifacts may expire but audit records must not be deleted.",
      "domain": "compliance",
      "enforcement": "db constraints",
      "id": "BI-1-EXPORT-AUDIT-IMMUTABLE",
      "level": "P0"
    }
  ],
  "metric_registry": {
    "dimension_catalog": [
      {
        "dimension": "event_id",
        "notes": "Event occurrence or event master id.",
        "type": "uuid_v7"
      },
      {
        "dimension": "ticket_type_id",
        "notes": "Ticket class/type id.",
        "type": "uuid_v7"
      },
      {
        "dimension": "currency",
        "notes": "ISO 4217 currency code.",
        "type": "atom"
      },
      {
        "dimension": "payment_status",
        "notes": "Committed/paid/failed states (ORD-1/LED-1).",
        "type": "atom"
      }
    ],
    "metric_definitions": [
      {
        "category": "finance",
        "definition": "Sum of settled gross ticket revenue (before refunds) derived from LED-1 postings for the period.",
        "dimensions_allowed": [
          "event_id",
          "currency"
        ],
        "exactness": "exact",
        "lane": "reconciliation_lane",
        "metric_id": "finance.gross_revenue_settled.day",
        "min_cohort_size": 0,
        "privacy_class": "c0",
        "read_model_ref": "rm_bi_led_settled_finance_day",
        "reconciliation_required": true,
        "retention_tier": "long",
        "time_bucket": "day",
        "title": "Gross revenue (settled)",
        "truth_source": "led_settled",
        "unit": "money_minor_units"
      },
      {
        "category": "finance",
        "definition": "Gross revenue minus refunds and chargebacks, derived from LED-1 postings for the period.",
        "dimensions_allowed": [
          "event_id",
          "currency"
        ],
        "exactness": "exact",
        "lane": "reconciliation_lane",
        "metric_id": "finance.net_revenue_settled.day",
        "min_cohort_size": 0,
        "privacy_class": "c0",
        "read_model_ref": "rm_bi_led_settled_finance_day",
        "reconciliation_required": true,
        "retention_tier": "long",
        "time_bucket": "day",
        "title": "Net revenue (settled)",
        "truth_source": "led_settled",
        "unit": "money_minor_units"
      },
      {
        "category": "finance",
        "definition": "Sum of settled refunds derived from LED-1 refund postings for the period.",
        "dimensions_allowed": [
          "event_id",
          "currency"
        ],
        "exactness": "exact",
        "lane": "reconciliation_lane",
        "metric_id": "finance.refunds_settled.day",
        "min_cohort_size": 0,
        "privacy_class": "c0",
        "read_model_ref": "rm_bi_led_settled_finance_day",
        "reconciliation_required": true,
        "retention_tier": "long",
        "time_bucket": "day",
        "title": "Refunds (settled)",
        "truth_source": "led_settled",
        "unit": "money_minor_units"
      },
      {
        "category": "finance",
        "definition": "Sum of committed order totals for the period. This is not settlement truth; it is a live indicator aligned to ORD-1 committed states.",
        "dimensions_allowed": [
          "event_id",
          "currency"
        ],
        "exactness": "bounded",
        "lane": "reconciliation_lane",
        "metric_id": "finance.gross_revenue_committed.day",
        "min_cohort_size": 0,
        "privacy_class": "c0",
        "read_model_ref": "rm_bi_ord_committed_finance_day",
        "reconciliation_required": true,
        "reconciliation_target_metric_id": "finance.gross_revenue_settled.day",
        "retention_tier": "short",
        "time_bucket": "day",
        "title": "Gross revenue (committed)",
        "truth_source": "ord_committed",
        "unit": "money_minor_units"
      },
      {
        "category": "finance",
        "definition": "Count of ticket quantities in committed orders for the period.",
        "dimensions_allowed": [
          "event_id",
          "ticket_type_id"
        ],
        "exactness": "bounded",
        "lane": "reconciliation_lane",
        "metric_id": "finance.tickets_sold_committed.day",
        "min_cohort_size": 0,
        "privacy_class": "c0",
        "read_model_ref": "rm_bi_ord_committed_sales_day",
        "reconciliation_required": true,
        "retention_tier": "short",
        "time_bucket": "day",
        "title": "Tickets sold (committed)",
        "truth_source": "ord_committed",
        "unit": "count"
      },
      {
        "category": "ops",
        "definition": "Rolling total committed revenue for the last complete hour (no dimensions). For operator awareness only.",
        "dimensions_allowed": [],
        "exactness": "approximate",
        "lane": "live_lane",
        "metric_id": "ops.gross_revenue_committed.hour_total",
        "min_cohort_size": 0,
        "privacy_class": "c0",
        "read_model_ref": "rm_bi_ord_committed_hour_totals",
        "reconciliation_required": false,
        "retention_tier": "short",
        "time_bucket": "hour",
        "title": "Gross revenue (committed) — last hour total",
        "truth_source": "ord_committed",
        "unit": "money_minor_units"
      },
      {
        "category": "ops",
        "definition": "Rolling total committed orders for the last complete hour (no dimensions).",
        "dimensions_allowed": [],
        "exactness": "approximate",
        "lane": "live_lane",
        "metric_id": "ops.orders_committed.hour_total",
        "min_cohort_size": 0,
        "privacy_class": "c0",
        "read_model_ref": "rm_bi_ord_committed_hour_totals",
        "reconciliation_required": false,
        "retention_tier": "short",
        "time_bucket": "hour",
        "title": "Orders (committed) — last hour total",
        "truth_source": "ord_committed",
        "unit": "count"
      },
      {
        "category": "ops",
        "definition": "Rolling total committed ticket quantities for the last complete hour (no dimensions).",
        "dimensions_allowed": [],
        "exactness": "approximate",
        "lane": "live_lane",
        "metric_id": "ops.tickets_sold_committed.hour_total",
        "min_cohort_size": 0,
        "privacy_class": "c0",
        "read_model_ref": "rm_bi_ord_committed_hour_totals",
        "reconciliation_required": false,
        "retention_tier": "short",
        "time_bucket": "hour",
        "title": "Tickets sold (committed) — last hour total",
        "truth_source": "ord_committed",
        "unit": "count"
      }
    ],
    "metric_id_rules": [
      "Lowercase, dot-separated: <category>.<name>.<grain>",
      "Must be stable; changing a definition requires a new metric_id"
    ],
    "required_fields": [
      "metric_id",
      "title",
      "category",
      "unit",
      "truth_source",
      "exactness",
      "definition",
      "dimensions_allowed",
      "time_bucket",
      "privacy_class",
      "min_cohort_size",
      "retention_tier",
      "reconciliation_required"
